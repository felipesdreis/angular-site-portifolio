{
  "redirects": [
    { "source": "/ride-planner", "destination": "/ride-planner/" },
    { "source": "/territorios", "destination": "/territorios/" }
  ],
  "rewrites": [
    { "source": "/locked-in", "destination": "/assets/locked-in/index.html" },
    { "source": "/grease", "destination": "/assets/grease/index.html" },
    { "source": "/extras", "destination": "/assets/extras/index.html" },
    { "source": "/ride-planner/", "destination": "/assets/ride-planner/index.html" },
    { "source": "/ride-planner/:path*", "destination": "/assets/ride-planner/:path*" },
    { "source": "/territorios/", "destination": "/assets/territorios/index.html" },
    { "source": "/territorios/:path*", "destination": "/assets/territorios/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
